# 本地开发栈凭据模板 —— 复制为 .env.local 后按需修改（.env.local 不入库）。
# 全部为本地假值；compose 用它初始化 postgres 与 api 容器环境。
# 随机生成密码示例：openssl rand -base64 24 | tr -d '/+=' | head -c 32
HGS_DB_USER=hgs_local
HGS_DB_PASSWORD=change-me-local-only
HGS_DB_NAME=hgs_local
HGS_TEST_DB_NAME=test_hgs
# seed.py 演示账号（hgs_admin）的密码
SEED_HGS_ADMIN_PASSWORD=change-me-seed-admin
