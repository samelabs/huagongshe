HGS_WORKAPI_URL=http://127.0.0.1:8000
HGS_WORKER_ID=worker-node-1
HGS_WORKER_TOKEN=replace-with-issued-token
HGS_WORKER_CONCURRENCY=2
HGS_PUBCHEM_REQUESTS_PER_SECOND=4
LOG_LEVEL=INFO
# 本机 SOCKS 出口代理(xray-pb.service 提供, 生产采集链路硬依赖):
