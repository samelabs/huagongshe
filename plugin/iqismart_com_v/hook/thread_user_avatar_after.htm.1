<script>
  window.onload =  function(){
    	$('.v_img_thread').each(function(index,e){
        	var v_img =  $(e);
          	//alert(v_img.attr('src'));
          
	       
          	var post_div = $(v_img).parent('.post')
            var avatar = post_div.find('img[class^="avatar"]');
          	var avatar_parent = post_div.find('img[class^="avatar"]').parent();
          	
           	avatar_parent.css('position','relative')
 			
          	v_img.insertAfter(avatar);
          	v_img.attr('style','position: absolute;bottom:2px;right: 2px;z-index:999;')
          	v_img.show();
          
          	if(avatar.attr('class') == 'avatar-1'
              || avatar.attr('class') == 'avatar-2'
              || avatar.attr('class') == 'avatar-3'){
            	v_img.attr('style','position: absolute;bottom:2px;right: 2px;z-index:999;width:12px;')
            }
          if(avatar.attr('class') == 'avatar-4'){
            	v_img.attr('style','position: absolute;bottom:2px;right: 2px;z-index:999;width:14px;')
          }
           if(avatar.attr('class') == 'avatar-5'){
            	v_img.attr('style','position: absolute;bottom:2px;right: 2px;z-index:999;width:16px;')
          }
           if(avatar.attr('class') == 'avatar-6'){
            	v_img.attr('style','position: absolute;bottom:2px;right: 2px;z-index:999;width:18px;')
          }
          	
        })
    } 
</script>